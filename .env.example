# Sentinel — copier en .env.local et renseigner.
# Seule FOUNDRY_API_KEY est indispensable pour une analyse complète.
# Sans elle, l'application tourne en mode dégradé : règles déterministes
# seulement, agents LLM annoncés comme indisponibles.

# --- LLM (endpoint compatible Anthropic) ------------------------------------
FOUNDRY_BASE_URL="https://<votre-ressource>.cognitiveservices.azure.com/anthropic/"
FOUNDRY_API_KEY=""
FOUNDRY_WORKER_DEPLOYMENT="claude-opus-4-6"   # les 7 agents
FOUNDRY_JUDGE_DEPLOYMENT="claude-opus-4-8"    # extraction du brief + résumé exécutif

# --- Boîte de réception : IMAP (voie la plus simple) ------------------------
# Mot de passe d'application, pas le mot de passe du compte.
# Le port 993 sortant est parfois fermé sur les postes d'entreprise.
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"

# --- Boîte de réception : Gmail API (OAuth, alternative à IMAP) -------------
# Console Google Cloud : activer l'API Gmail, écran de consentement External en
# mode Testing avec votre adresse en utilisateur de test, client OAuth de type
# Web. En mode Testing le consentement expire tous les 7 jours.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# --- Boîte de réception : Outlook / Microsoft Graph -------------------------
# App registration Entra, redirection de type Web, permissions déléguées
# Mail.Read et offline_access.
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_REDIRECT_URI="http://localhost:3000/api/auth/outlook/callback"
MS_TENANT="common"

# --- Persistance ------------------------------------------------------------
# Vide en local : les données vont dans .data/ au format JSON.
# Renseignée en production : bascule sur Azure Table Storage.
AZURE_TABLES_CONNECTION_STRING=""
DATA_DIR=".data"

# --- Accès ------------------------------------------------------------------
# Vide en local : aucun mot de passe demandé.
# En production, une valeur est OBLIGATOIRE : sans elle tout répond 503.
SENTINEL_ACCESS_KEY=""

# --- Options d'analyse ------------------------------------------------------
QA_EXTENDED="1"        # 1 active l'agent Assets et les règles de qualité générique
RENDER_REAL="0"        # 1 active la capture navigateur (local uniquement)
RENDER_VISION="0"      # 1 active l'agent vision sur les captures
BATCH_CONCURRENCY="2"  # analyses simultanées lors d'un traitement par lot
